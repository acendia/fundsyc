{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fundsyc-dev",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cf3e84a27e184157817550cf8e936149"
    }
  ],
  "routes": [
    {
      "pattern": "dev.fundsyc.com",
      "custom_domain": true
    }
  ]
}
