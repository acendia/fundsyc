{
  "name": "fundsyc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc --noEmit && vite build",
    "dev:api": "node --watch server/local.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:worker": "npm run build && wrangler dev --local"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "multer": "2.5.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^10.0.6",
    "supabase": "2.122.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wrangler": "4.156.0"
  }
}
